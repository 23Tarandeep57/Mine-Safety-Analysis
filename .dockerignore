# =============================================================================
# Docker Ignore - Exclude from build context
# =============================================================================

# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
.env
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Frontend (handled by its own Dockerfile)
Front-end/

# Large data files (mount as volumes instead)
data/
chroma_db/
cause_code_db/

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Documentation
docs/
*.md
!README.md

# Temporary files
tmp/
temp/
*.tmp
