# =============================================================================
# Mine Safety Analysis - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# Required API Keys
# =============================================================================
# Get your Groq API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# Optional Configuration
# =============================================================================
# LLM Model (default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# MongoDB (defaults work with docker-compose)
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=mine_safety
# MONGODB_COLLECTION=dgms_reports

# Redis (defaults work with docker-compose)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Development Settings
# =============================================================================
# FLASK_ENV=development
# FLASK_DEBUG=1
